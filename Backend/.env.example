# HTTP API. Comma-separate additional trusted frontend origins.
NODE_ENV=development
PORT=5001
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
API_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=20
SESSION_RATE_LIMIT_MAX=120

# LLM provider. The current legacy chat path requires Gemini at startup.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TITLE_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048


# Embeddings. Ollama runs locally by default; the legacy service uses
# nomic-embed-text. Do not change embedding model/index dimensions without
# rebuilding and validating the vector index.
OLLAMA_BASE_URL=http://localhost:11434

# Optional; set to a locally installed Chrome/Chromium binary when Playwright's
# managed Chromium browser has not been installed on this machine.
MOSDAC_BROWSER_EXECUTABLE_PATH=

# Optional BM25 sidecar built from a reviewed PDF chunk-plan report. Leaving
# this unset preserves the legacy dense-only retrieval path.
MOSDAC_LEXICAL_INDEX_PATH=

# MongoDB conversation history.
MONGO_URI=
MONGO_DB_NAME=Ketan
MONGO_COLLECTION_NAME=Astro
MONGO_MESSAGES_COLLECTION_NAME=astrolynx_chat_messages_v2

# Pinecone. PINECONE_ENVIRONMENT is retained for compatibility with older
# deployments; current SDK initialization needs the API key and index name.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=astro
PINECONE_ENVIRONMENT=

# Optional legacy Neo4j integration. Leave all three blank for normal chat.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Optional speech provider and legacy secret.
SARVAM_AI_API_KEY=
JWT_SECRET=
